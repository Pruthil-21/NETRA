# Camera Registry API (backend-registry). Falls back to http://localhost:5001 (json-server mock) if unset.
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:5001

# MediaMTX HLS output (owned by the streaming module). Used to derive each camera's
# live playback URL from its rtsp_url: `${NEXT_PUBLIC_MEDIAMTX_HLS_URL}/<path>/index.m3u8`.
# Falls back to http://localhost:8888 if unset. May be a Cloudflare tunnel URL
# (https://*.trycloudflare.com) when the streaming engineer exposes MediaMTX remotely —
# ask them for the current value, since tunnel URLs change on restart.
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost:8888

# CartoDB dark basemap tiles. Free, get one at https://carto.com/basemaps/apikey/
# (email + domain, no account needed, key emailed instantly). Without this,
# tiles load but are watermarked "API KEY REQUIRED".
NEXT_PUBLIC_CARTO_API_KEY=
