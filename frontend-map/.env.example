# Camera Registry API (backend-registry). Falls back to http://localhost:5001 (json-server
# mock) if unset. Set to the real backend (e.g. http://localhost:8000) once it's reachable;
# switch back to http://localhost:5001 (with `npm run mock-api` running) to use the mock.
NEXT_PUBLIC_REGISTRY_API_URL=http://localhost:8000

# MediaMTX HLS output (owned by the streaming module). Used to derive each camera's
# live playback URL from its rtsp_url: `${NEXT_PUBLIC_MEDIAMTX_HLS_URL}/<path>/index.m3u8`.
# Falls back to http://localhost:8888 if unset. May be a Cloudflare tunnel URL
# (https://*.trycloudflare.com) when the streaming engineer exposes MediaMTX remotely —
# ask them for the current value, since tunnel URLs change on restart.
NEXT_PUBLIC_MEDIAMTX_HLS_URL=http://localhost:8888

# Full LL-HLS playlist URL for the "Pruthil's Phone" test CCTV camera
# (lib/testCameras.ts) — a separate MediaMTX instance/tunnel (the streaming
# engineer's Mac + Tailscale) from the organizer relay above.
NEXT_PUBLIC_PHONE_CAM_HLS_URL=

# Full LL-HLS playlist URL for the "iPhone 17 Pro Max" test CCTV camera
# (lib/testCameras.ts), published via Larix Broadcaster to the same MediaMTX
# instance/tunnel as the phone camera above. Ask the streaming engineer for
# the path name they configured and the current tunnel URL.
NEXT_PUBLIC_IPHONE_CAM_HLS_URL=

# Full LL-HLS playlist URL for the "Xiaomi Camera" test CCTV camera
# (lib/testCameras.ts). Cloudflare Quick Tunnel URL — rotates whenever the
# streaming server restarts, ask the streaming engineer for the current value.
NEXT_PUBLIC_XIAOMI_CAM_HLS_URL=

# WebRTC/WHEP base for the selected camera's live player (frontend-map only —
# frontend-dashboard stays on LL-HLS). Falls back to LL-HLS automatically if
# unset, unreachable, or negotiation fails. Requires Tailscale connected since
# this endpoint lives on the tailnet.
NEXT_PUBLIC_MEDIAMTX_WEBRTC_URL=

# CartoDB dark basemap tiles. Free, get one at https://carto.com/basemaps/apikey/
# (email + domain, no account needed, key emailed instantly). Without this,
# tiles load but are watermarked "API KEY REQUIRED".
NEXT_PUBLIC_CARTO_API_KEY=

# Watchlist/detections API (backend-watchlist, a separate service from
# backend-registry above -- port 8001 per docker-compose.yml). Falls back
# to http://localhost:8001 if unset. Used by the vehicle-search feature's
# GET /detections?plate_number=... call. GET /detections is officer-role
# JWT-gated per contract/API_CONTRACT.md, but frontend-map has no real JWT
# auth flow yet -- confirm the real deployed value and auth story with P6
# before demo.
NEXT_PUBLIC_WATCHLIST_API_URL=http://localhost:8001
