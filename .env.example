DATABASE_URL=postgresql://netra:netra@localhost:5432/netra
MEDIAMTX_RTSP_URL=rtsp://localhost:8554
MEDIAMTX_HLS_URL=http://localhost:8888
MEDIAMTX_WEBRTC_URL=http://localhost:8889

# Email 2FA / self-service password reset (backend-registry) -- optional.
# Opt-in per officer (see officers.email in schema.sql), so leaving these
# unset just means no officer can turn 2FA on yet; nothing else changes.
RESEND_API_KEY=
RESEND_FROM_EMAIL=DIGDHRISHTI <onboarding@resend.dev>

# DIGDHRISHTI Federation middleware proxy (backend-registry/app/federation_proxy.py)
# -- optional. Leaving these unset means every /federation/* route 503s
# ("Inventory service unavailable"); nothing else in the app depends on them.
# FEDERATION_URL is that standalone service's own base API URL (e.g.
# http://127.0.0.1:8096 for the scale-revision compose, or 8095 for the
# older prototype); FEDERATION_SERVICE_KEY is its shared backend-to-service
# key -- never a browser login or frontend env var.
FEDERATION_URL=
FEDERATION_SERVICE_KEY=

# DIGDHRISHTI continuous-recording service (streaming/recording -- Dhruv's
# project, deployed independently) -- optional. Leaving these unset means
# GET /cameras/{id}/recordings and /recordings/health report "unavailable"
# (Archive shows no footage for any camera) instead of erroring.
# RECORDING_SERVICE_URL is that service's own deployed base URL;
# RECORDING_SERVICE_KEY is its shared backend-to-service key -- never a
# browser login or frontend env var.
RECORDING_SERVICE_URL=
RECORDING_SERVICE_KEY=

# Inbound sink for the recording service's recording-health events
# (backend-registry/app/routers/recording_webhooks.py, POST
# /recordings/health-events) -- optional. Leaving it unset means the sink
# rejects every call with 401, so no unauthenticated deployment ever
# silently accepts events. Give this same value to Dhruv as the sink's
# required X-Webhook-Key header.
RECORDING_WEBHOOK_KEY=

# Named Cloudflare Tunnel token for api.digdhrishti.me -> backend-watchlist
# (docker-compose.yml's cloudflared service) -- optional. Get it from the
# Cloudflare Zero Trust dashboard (Networks > Tunnels > this tunnel >
# Configure > Install connector). Leaving it unset just means the
# cloudflared container exits immediately; everything else still runs on
# localhost.
CLOUDFLARE_TUNNEL_TOKEN=

# Named Cloudflare Tunnel token for backend-registry (docker-compose.yml's
# cloudflared-registry service) -- optional. Create a separate tunnel for
# this in the same Cloudflare Zero Trust dashboard (Networks > Tunnels >
# Create a tunnel > Docker connector), add a Public Hostname pointing at
# backend-registry:8000 (the in-network container port, not the
# host-published one), then paste the token from the install command here.
# Leaving it unset just means this cloudflared container exits immediately;
# backend-registry still runs fine on localhost, same as before this existed.
CLOUDFLARE_REGISTRY_TUNNEL_TOKEN=
