FROM python:3.13-slim
WORKDIR /service
COPY requirements*.txt ./
RUN pip install --no-cache-dir -r requirements-federation.txt && useradd --uid 10001 --create-home federation
COPY app ./app
COPY federation ./federation
USER federation
CMD ["uvicorn", "federation.main:create_app", "--factory", "--host", "0.0.0.0", "--port", "8090"]
