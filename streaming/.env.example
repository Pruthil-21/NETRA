# DIGDHRISHTI streaming: Compose settings (copy to .env if needed).
CAMERA_LIMIT=30
RELAY_FPS=15
RETRY_SECONDS=10
AUTH_REFRESH_SECONDS=600
STALL_SECONDS=45
MIN_ONLINE_CAMERAS=1

# Legacy helper values; the main Compose stack does not consume these.
RTSP_PORT=8554
RTSP_PATH=sentinel_cam

# Optional external/portal stream endpoint for testing
# REMOTE_STREAM_URL=https://example.com/live/stream.m3u8
